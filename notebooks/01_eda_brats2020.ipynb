  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 01 - EDA BraTS 2020 NIfTI\n",
    "\n",
    "Exploration des modalités MRI, des dimensions et des masques. Le notebook ne modifie pas les données originales et peut être ouvert avant le téléchargement du dataset."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import nibabel as nib\n",
    "REPO_ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "REPO_ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",\n+    "REPO_ROOT = Path.cwd().parent if Path.cwd().name == \"notebooks\" else Path.cwd()\n",
    "DATA_ROOT = REPO_ROOT / \"data/raw/brats2020-training-data\"\n",
    "FIGURE_ROOT = REPO_ROOT / \"results/figures/eda\"\n",
    "FIGURE_ROOT.mkdir(parents=True, exist_ok=True)\n",
    "files = sorted(list(DATA_ROOT.rglob(\"*.nii.gz\")) + list(DATA_ROOT.rglob(\"*.nii\")))\n",
    "print(f\"Dataset: {DATA_ROOT}\")\n",
    "print(f\"Fichiers NIfTI: {len(files)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def modality(path: Path) -> str:\n",
    "    name = path.name.lower().replace(\".nii.gz\", \"\").replace(\".nii\", \"\")\n",
    def patient_id(path: Path) -> str:\n+    "    name = path.name.lower().replace(\".nii.gz\", \"\").replace(\".nii\", \"\")\n",
    "    return next((suffix[1:] for suffix in (\"_flair\", \"_t1ce\", \"_t1\", \"_t2\", \"_seg\") if name.endswith(suffix)), \"unknown\")\n",
    "\n",
    "def patient_id(path: Path) -> str:\n",
    "    name = path.name.lower().replace(\".nii.gz\", \"\").replace(\".nii\", \"\")\n",\n+    def patient_id(path: Path) -> str:\n+    "    name = path.name.lower().replace(\".nii.gz\", \"\").replace(\".nii\", \"\")\n",
    "    suffix = f\"_{modality(path)}\"\n",
    "    return name[:-len(suffix)] if name.endswith(suffix) else name\n",
    "\n",
    "if not files:\n",
    "    print(\"Aucun fichier trouvé. Téléchargez BraTS puis relancez les cellules suivantes.\")\n",
    "else:\n",
    "    table = pd.DataFrame({\"path\": files})\n",
    "    table[\"patient\"] = table[\"path\"].map(patient_id)\n",
    "    table[\"modality\"] = table[\"path\"].map(modality)\n",
    "    display(table.groupby(\"modality\").size().rename(\"count\").to_frame())\n",
    "    display(table.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if files:\n",
    "    rows = []\n",
    "    for path in files:\n",
    "        image = nib.load(str(path))\n",
    "        rows.append({\"patient\": patient_id(path), \"modality\": modality(path), \"shape\": tuple(image.shape), \"spacing\": tuple(image.header.get_zooms()[:3]), \"orientation\": \"\".join(nib.aff2axcodes(image.affine))})\n",
    "    metadata = pd.DataFrame(rows)\n",
    "    display(metadata.groupby(\"modality\")[['shape', 'spacing', 'orientation']].first())\n",
    "    metadata.to_csv(FIGURE_ROOT / \"volume_metadata.csv\", index=False)\n",
    "\n",
    "    sample = table[table[\"modality\"] == \"flair\"].iloc[0][\"path\"]\n",
    "    volume = np.asarray(nib.load(str(sample)).get_fdata(), dtype=np.float32)\n",
    "    index = volume.shape[2] // 2\n",
    "    plt.figure(figsize=(5, 5))\n",
    "    plt.imshow(volume[:, :, index].T, cmap=\"gray\", origin=\"lower\")\n",
    "    plt.title(f\"FLAIR - coupe {index}\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIGURE_ROOT / \"flair_middle_slice.png\", dpi=150)\n",
    "    plt.show()"
   ]
  }
 ],
